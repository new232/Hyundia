      </column>
      <column caption='profit ratio' datatype='real' name='[Calculation_0624582724939776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Profit Ratio Total' datatype='real' name='[Calculation_0624582733045761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Profit status' datatype='string' name='[Calculation_0624582735212549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Profit] &lt;0 then &quot;손실&quot; ELSE &quot;비손실&quot; END' />
      </column>
      <column caption='Discount Level' datatype='string' name='[Calculation_0624582735945734]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] &gt;= 0.5 then&#13;&#10; &quot;높은&quot;&#13;&#10;ELSEIF [Discount] &gt;= 0.2 THEN&#13;&#10; &quot;보통&quot;&#13;&#10;ELSE&#13;&#10;  &quot;낮음&quot;&#13;&#10;END' />
      </column>
      <column caption='Shipping Days' datatype='integer' name='[Calculation_0624582736674823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [Order Date],&#13;&#10;    [Ship Date]&#13;&#10;)' />
      </column>
      <column caption='Shipping Status' datatype='string' name='[Calculation_0624582739947528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0624582736674823] &gt;= 5 THEN &quot;5일 이상&quot; ELSE &quot;5일 미만&quot; END' />
      </column>
      <column caption='Failure Status' datatype='string' name='[Calculation_0624582742646794]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Machine failure] = 1 THEN&#13;&#10; &quot;고장&quot;&#13;&#10;ELSE &#13;&#10;    &quot;정상&quot;&#13;&#10;END' />
      </column>
      <column caption='Tool Wear Status' datatype='string' name='[Calculation_0624582743437323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tool wear (min)] &gt;= 200 THEN    &#13;&#10; &quot;200분 이상&quot; &#13;&#10;ELSE&#13;&#10; &quot;200분 미만&quot; &#13;&#10;END' />
      </column>
      <column caption='product type' datatype='string' name='[Calculation_0624582767702050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Type] = &quot;L&quot; THEN &quot;LOW&quot;&#13;&#10;ELSEIF [Type]= &quot;M&quot; THEN &quot;MIDDLE&quot;&#13;&#10;ELSE &quot;HIGH&quot;&#13;&#10;END' />
      </column>
      <column caption='이전달 매출' datatype='real' name='[Calculation_0624582770561060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='순번' datatype='integer' name='[Calculation_0624582772072489]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
