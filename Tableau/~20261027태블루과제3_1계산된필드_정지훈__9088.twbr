      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0i45rn41k96mwf1ealulz1g5yk9k].[rank:sum:Machine failure:qk]&quot;' value='순위' />
